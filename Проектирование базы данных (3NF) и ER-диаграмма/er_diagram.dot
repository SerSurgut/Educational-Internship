// ER-диаграмма БД «Партнёры и отгрузки»
// Сборка: dot -Tpdf er_diagram.dot -o er_diagram.pdf
digraph ER {
    graph [rankdir=LR, splines=spline, nodesep=0.6, ranksep=1.6, fontname="DejaVu Sans",
           fontsize=16, labelloc="t",
           label=<<br/><b>ER-диаграмма БД «Партнёры и отгрузки» (3NF)</b><br/>
                  <font point-size="10">PK — первичный ключ, FK — внешний ключ, U — уникальный, NN — обязательный</font><br/> >];
    node [shape=plaintext, fontname="DejaVu Sans", fontsize=11];
    edge [fontname="DejaVu Sans", fontsize=10, color="#37474f", penwidth=1.3, arrowsize=1.4];

    partners [label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5">
        <TR><TD COLSPAN="3" BGCOLOR="#1f4e79"><FONT COLOR="white"><B>partners — Партнёры</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><B>partner_id</B></TD><TD ALIGN="LEFT">serial</TD></TR>
        <TR><TD ALIGN="LEFT">NN</TD><TD ALIGN="LEFT">company_name</TD><TD ALIGN="LEFT">varchar(150)</TD></TR>
        <TR><TD ALIGN="LEFT">U, NN</TD><TD ALIGN="LEFT">inn</TD><TD ALIGN="LEFT">varchar(12)</TD></TR>
        <TR><TD ALIGN="LEFT">U</TD><TD ALIGN="LEFT">contact_email</TD><TD ALIGN="LEFT">varchar(120)</TD></TR>
        <TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">phone</TD><TD ALIGN="LEFT">varchar(20)</TD></TR>
        <TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">rating</TD><TD ALIGN="LEFT">decimal(3,2)</TD></TR>
      </TABLE>>];

    products [label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5">
        <TR><TD COLSPAN="3" BGCOLOR="#1b5e20"><FONT COLOR="white"><B>products — Продукция</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><B>product_id</B></TD><TD ALIGN="LEFT">serial</TD></TR>
        <TR><TD ALIGN="LEFT">U, NN</TD><TD ALIGN="LEFT">product_name</TD><TD ALIGN="LEFT">varchar(150)</TD></TR>
      </TABLE>>];

    sales [label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5">
        <TR><TD COLSPAN="3" BGCOLOR="#7b1e3a"><FONT COLOR="white"><B>sales — Отгрузки</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><B>sale_id</B></TD><TD ALIGN="LEFT">serial</TD></TR>
        <TR><TD ALIGN="LEFT"><B>FK</B>, NN</TD><TD ALIGN="LEFT">partner_id</TD><TD ALIGN="LEFT">int &#8594; partners</TD></TR>
        <TR><TD ALIGN="LEFT"><B>FK</B>, NN</TD><TD ALIGN="LEFT">product_id</TD><TD ALIGN="LEFT">int &#8594; products</TD></TR>
        <TR><TD ALIGN="LEFT">NN</TD><TD ALIGN="LEFT">sale_date</TD><TD ALIGN="LEFT">date</TD></TR>
        <TR><TD ALIGN="LEFT">NN</TD><TD ALIGN="LEFT">quantity</TD><TD ALIGN="LEFT">int</TD></TR>
        <TR><TD ALIGN="LEFT">NN</TD><TD ALIGN="LEFT">total_amount</TD><TD ALIGN="LEFT">decimal(12,2)</TD></TR>
      </TABLE>>];

    partners -> sales [arrowhead=ocrow, arrowtail=teetee, dir=both, taillabel="1", headlabel="0..N",
                       labeldistance=2.0, labelangle=15, label="  один партнёр —\l  много отгрузок\l"];
    products -> sales [arrowhead=ocrow, arrowtail=teetee, dir=both, taillabel="1", headlabel="0..N",
                       labeldistance=2.0, labelangle=15, label="  один товар —\l  много отгрузок\l"];

    {rank=same; partners; products;}
}
